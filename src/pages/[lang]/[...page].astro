---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import ProductCard from '../../components/ProductCard.astro';
import {locales,nav,products,projects,categories,site,pick,whatsapp,type Locale} from '../../data/site';
export function getStaticPaths(){const pages=[...nav.map(n=>n.path),'privacy',...products.map(p=>'products/'+p.slug),...projects.map(p=>'projects/'+p.slug)];return locales.flatMap(lang=>pages.map(page=>({params:{lang,page}})));}
const lang=Astro.params.lang as Locale;
const page=Astro.params.page!;
const t=(en:string,id:string)=>pick(lang,en,id);
const product=products.find(p=>page==='products/'+p.slug);
const project=projects.find(p=>page==='projects/'+p.slug);
const titles:Record<string,string>={about:t('A closer look at MGA.','Mengenal MGA lebih dekat.'),products:t('Find your glassware.','Temukan glassware Anda.'),services:t('Made around your requirements.','Berangkat dari kebutuhan Anda.'),projects:t('Glassware in context.','Glassware dalam konteksnya.'),contact:t('Let’s start a conversation.','Mari mulai percakapan.'),privacy:t('Your information, handled clearly.','Informasi Anda, dikelola dengan jelas.')};
const title=product?.[lang]??project?.[lang]??titles[page];
---
<Layout lang={lang} title={title} path={page}>
<section class="container page-heading"><div class="breadcrumbs"><a href={`/${lang}/`}>{t('Home','Beranda')}</a><span>/</span>{product?<a href={`/${lang}/products/`}>{t('Products','Produk')}</a>:project?<a href={`/${lang}/projects/`}>{t('Projects','Proyek')}</a>:<span>MGA</span>}</div><span class="eyebrow">{product?t('PRODUCT PREVIEW','PREVIEW PRODUK'):project?t('SOURCE CASE PREVIEW','PREVIEW KASUS SUMBER'):t('MEKANIKAL GLASS ANALITIK','MEKANIKAL GLASS ANALITIK')}</span><h1>{title}</h1></section>
{page==='about'&&<><section class="container section content-grid"><div><h2>{t('Laboratory needs. Glass expertise.','Kebutuhan laboratorium. Keahlian kaca.')}</h2><p>{t('PT Mekanikal Glass Analitik is based in Bandung, Indonesia. This website introduces the company’s laboratory glassware range and provides a direct way to discuss custom requirements.','PT Mekanikal Glass Analitik berlokasi di Bandung, Indonesia. Website ini memperkenalkan pilihan glassware laboratorium perusahaan dan menyediakan cara langsung untuk mendiskusikan kebutuhan custom.')}</p><p>{t('Company materials trace the beginnings of CV Karya Mekanikal Scientific to 2006. The legal history and incorporation date of the PT are being reviewed for the final company profile.','Materi perusahaan mencatat awal perjalanan CV Karya Mekanikal Scientific pada 2006. Riwayat legal dan tanggal pendirian PT sedang ditinjau untuk profil perusahaan final.')}</p><div class="review-note">{t('Preview note: the final company narrative, vision and mission will follow the company’s content review.','Catatan preview: narasi perusahaan, visi dan misi final mengikuti review konten perusahaan.')}</div></div><div class="story-panel"><span class="eyebrow">BANDUNG, INDONESIA</span><h3>{t('Office & workshop','Office & workshop')}</h3><p>{t('Two locations on Jl. Bukit Reuma, with dedicated contacts for your enquiries.','Dua lokasi di Jl. Bukit Reuma, dengan kontak khusus untuk kebutuhan Anda.')}</p><a class="text-link" href={`/${lang}/contact/`}>{t('See our locations','Lihat lokasi kami')} →</a></div></section><CTA lang={lang}/></>}
{page==='products'&&<section class="container section catalogue"><p class="section-intro">{t('Start with a product family, then speak with our team about the configuration you need. This preview contains three representative entries; final products and specifications are being reviewed.','Mulai dari keluarga produk, lalu diskusikan konfigurasi yang dibutuhkan dengan tim kami. Preview ini memuat tiga contoh representatif; produk dan spesifikasi final sedang ditinjau.')}</p><div class="catalogue-controls"><label for="search">{t('Search catalogue','Cari katalog')}<input id="search" type="search" placeholder={t('Search a product…','Cari produk…')}/></label><label for="category">{t('Product family','Kategori produk')}<select id="category"><option value="all">{t('All product families','Semua kategori')}</option>{categories.map(c=><option value={c.id}>{lang==='en'?c.en:c.idName}</option>)}</select></label></div><p id="result-count" aria-live="polite" data-en="products shown" data-id="produk ditampilkan">3 {t('products shown','produk ditampilkan')}</p><div class="product-grid" id="catalogue-results">{products.map(product=><div data-product data-search={`${product.en} ${product.id}`.toLowerCase()} data-category={product.category}><ProductCard lang={lang} product={product}/></div>)}</div><div id="empty-results" class="empty-state" hidden><h2>{t('No preview products in this selection.','Belum ada produk preview pada pilihan ini.')}</h2><p>{t('Try another search or ask our team about your requirements.','Coba pencarian lain atau tanyakan kebutuhan Anda kepada tim kami.')}</p><a class="button" href={`/${lang}/contact/`}>{t('Ask the team','Tanyakan kepada tim')} ↗</a></div></section>}
{product&&<><section class="container section detail-grid"><div class="detail-image"><img src={`/images/${product.image}`} alt={product[lang]} width="650" height="650"/></div><div><span class="eyebrow">{t('LABORATORY GLASSWARE','GLASSWARE LABORATORIUM')}</span><h2>{product[lang]}</h2><p class="lead">{product.summary[lang]}</p><dl class="spec-list"><div><dt>{t('Availability & configuration','Ketersediaan & konfigurasi')}</dt><dd>{t('Confirm with the MGA team','Konfirmasikan dengan tim MGA')}</dd></div><div><dt>{t('Dimensions & connections','Dimensi & sambungan')}</dt><dd>{t('Discuss your application requirements','Diskusikan kebutuhan aplikasi Anda')}</dd></div><div><dt>{t('Price','Harga')}</dt><dd>{t('Quotation on enquiry','Penawaran melalui inquiry')}</dd></div></dl><div class="review-note">{t('Representative catalogue entry. Dimensions, materials, package contents and technical specifications are not yet final.','Contoh entri katalog. Dimensi, material, isi paket dan spesifikasi teknis belum final.')}</div><a class="button" href={whatsapp(t(`Hello MGA, I would like to enquire about ${product.en}.`,`Halo MGA, saya ingin bertanya tentang ${product.id}.`))}>{t('Enquire on WhatsApp','Tanyakan via WhatsApp')} ↗</a><a class="text-link" href={`/${lang}/contact/?product=${encodeURIComponent(product[lang])}`}>{t('Prepare an enquiry','Siapkan inquiry')} →</a></div></section><section class="container section"><h2>{t('Explore more glassware','Jelajahi glassware lainnya')}</h2><div class="product-grid">{products.filter(p=>p.slug!==product.slug).map(p=><ProductCard lang={lang} product={p}/>)}</div></section></>}
{page==='services'&&<><section class="container section content-grid"><div><h2>{t('Start with the application.','Mulai dari aplikasinya.')}</h2><p class="lead">{t('Tell us what your apparatus needs to do. Share reference drawings, dimensions, connection requirements and the intended use so we can discuss a custom glassware request.','Ceritakan fungsi apparatus yang Anda butuhkan. Sampaikan gambar acuan, dimensi, kebutuhan sambungan dan tujuan penggunaan agar kita dapat mendiskusikan permintaan glassware custom.')}</p><ol class="service-steps">{[[t('Share the brief','Sampaikan kebutuhan'),t('Application, reference drawing and quantity.','Aplikasi, gambar acuan dan jumlah.')],[t('Review the requirements','Tinjau kebutuhan'),t('Discuss the configuration and details with the workshop.','Diskusikan konfigurasi dan detail dengan workshop.')],[t('Request a quotation','Minta penawaran'),t('Scope, price and delivery are confirmed individually.','Scope, harga dan pengiriman dikonfirmasi per permintaan.')]].map(item=><li><h3>{item[0]}</h3><p>{item[1]}</p></li>)}</ol><a class="button" href={whatsapp(t('Hello MGA, I would like to discuss a custom glassware request.','Halo MGA, saya ingin mendiskusikan kebutuhan glassware custom.'),true)}>{t('Talk to the workshop','Hubungi workshop')} ↗</a></div><aside class="story-panel"><span class="eyebrow">{t('BEFORE WE BEGIN','SEBELUM MEMULAI')}</span><h3>{t('A useful starting point','Bahan diskusi awal')}</h3><ul><li>{t('Intended application','Tujuan aplikasi')}</li><li>{t('Dimensions and connection details','Dimensi dan detail sambungan')}</li><li>{t('Quantity and desired schedule','Jumlah dan jadwal yang diharapkan')}</li></ul><p class="review-note">{t('Repair and calibration scope are awaiting confirmation and are not offered as confirmed services in this preview.','Cakupan repair dan kalibrasi menunggu konfirmasi dan belum ditawarkan sebagai layanan terkonfirmasi pada preview ini.')}</p></aside></section><CTA lang={lang}/></>}
{page==='projects'&&<section class="container section"><p class="section-intro">{t('The following cases are drawn from company source materials. They are presented as review candidates; client names, technical details, images and publication permissions are not yet final.','Kasus berikut berasal dari materi sumber perusahaan dan ditampilkan sebagai kandidat review. Nama klien, detail teknis, gambar dan izin publikasi belum final.')}</p><div class="project-grid">{projects.map((p,i)=><a class="project-card" href={`/${lang}/projects/${p.slug}/`}><div class="project-placeholder"><span>0{i+1} / MGA</span><strong>{t('Case preview','Preview kasus')}</strong><small>{t('Project photography pending','Foto proyek menunggu konfirmasi')}</small></div><h2>{p[lang]}</h2><p>{p.summary[lang]}</p><span class="card-link">{t('View source case','Lihat kasus sumber')} ↗</span></a>)}</div></section>}
{project&&<><section class="container section content-grid"><div><h2>{project[lang]}</h2><p class="lead">{project.summary[lang]}</p><p>{t('This case is referenced on page 14 of the supplied company profile. The final project description and technical scope will be added after review by the company.','Kasus ini dirujuk pada halaman 14 company profile yang diberikan. Deskripsi proyek final dan cakupan teknis akan ditambahkan setelah review perusahaan.')}</p><div class="review-note">{t('Client identity, results, photographs and performance claims are not published in this preview.','Identitas klien, hasil, foto dan klaim kinerja tidak dipublikasikan pada preview ini.')}</div><a class="button" href={`/${lang}/contact/`}>{t('Discuss a similar requirement','Diskusikan kebutuhan serupa')} ↗</a></div><div class="project-placeholder"><strong>{t('Source case / review pending','Kasus sumber / menunggu review')}</strong><small>{t('Project photography pending','Foto proyek menunggu konfirmasi')}</small></div></section><CTA lang={lang}/></>}
{page==='contact'&&<><section class="container section contact-layout"><div><p class="lead">{t('Choose the office for general enquiries, or the workshop to discuss technical requirements.','Hubungi office untuk pertanyaan umum, atau workshop untuk mendiskusikan kebutuhan teknis.')}</p>{[site.office,site.workshop].map((location,i)=><article class="contact-card"><span class="eyebrow">{i===0?'OFFICE':'WORKSHOP'}</span><h2>{location.name}</h2><p>{location.address}</p><a class="text-link" href={`https://wa.me/${location.wa}`}>WhatsApp · {location.whatsapp} ↗</a>{i===0&&<a class="text-link" href={`tel:${site.office.tel}`}>{t('Phone','Telepon')} · {site.office.phone}</a>}</article>)}<a class="email-link" href={`mailto:${site.email}`}>{site.email}</a></div><aside class="enquiry-panel"><span class="eyebrow">{t('PREPARE YOUR ENQUIRY','SIAPKAN INQUIRY ANDA')}</span><h2>{t('Tell us what you need.','Ceritakan kebutuhan Anda.')}</h2><p>{t('This form prepares a message in WhatsApp. You review and send it there; the website does not submit or store your enquiry.','Form ini menyiapkan pesan di WhatsApp. Anda memeriksa dan mengirimnya di sana; website tidak mengirim atau menyimpan inquiry Anda.')}</p><form id="enquiry-form"><label for="enquiry-name">{t('Your name','Nama Anda')}<input id="enquiry-name" name="name" autocomplete="name" required maxlength="100"/></label><label for="enquiry-product">{t('Product or service','Produk atau layanan')}<input id="enquiry-product" name="product" maxlength="150"/></label><label for="enquiry-message">{t('Your requirements','Kebutuhan Anda')}<textarea id="enquiry-message" name="message" rows="4" required maxlength="2000"></textarea></label><p class="form-note">{t('Continue to WhatsApp to send your message. Please avoid including sensitive information.','Lanjutkan ke WhatsApp untuk mengirim pesan. Hindari mencantumkan informasi sensitif.')}</p><button type="submit" class="button">{t('Continue to WhatsApp','Lanjutkan ke WhatsApp')} ↗</button><noscript><p>{t('Use the direct WhatsApp or email links to contact us.','Gunakan tautan WhatsApp atau email langsung untuk menghubungi kami.')}</p></noscript></form></aside></section></>}
{page==='privacy'&&<section class="container section prose"><div class="review-note">{t('Draft for client review. The final policy and responsible contact must be approved before production launch.','Draft untuk review klien. Kebijakan final dan kontak penanggung jawab harus disahkan sebelum peluncuran produksi.')}</div><h2>{t('How this preview works','Cara kerja preview ini')}</h2><p>{t('This preview has no account registration, enquiry database or analytics integration. The enquiry form prepares a WhatsApp message on your device. It is only sent when you choose to send it in WhatsApp.','Preview ini tidak memiliki pendaftaran akun, database inquiry atau integrasi analitik. Form inquiry menyiapkan pesan WhatsApp pada perangkat Anda. Pesan hanya terkirim ketika Anda memilih mengirimnya di WhatsApp.')}</p><h2>{t('External services','Layanan eksternal')}</h2><p>{t('WhatsApp and your email application process communications under their own service policies. The hosting provider may process technical connection information to serve this website.','WhatsApp dan aplikasi email Anda memproses komunikasi berdasarkan kebijakan layanan masing-masing. Penyedia hosting dapat memproses informasi koneksi teknis untuk menayangkan website ini.')}</p><h2>{t('Contact and remaining decisions','Kontak dan keputusan tersisa')}</h2><p>{t('For questions, use the public company email below. Internal access, retention of received messages and responsibility for privacy requests are awaiting company confirmation.','Untuk pertanyaan, gunakan email publik perusahaan berikut. Akses internal, retensi pesan yang diterima dan penanggung jawab permintaan privasi menunggu konfirmasi perusahaan.')}</p><a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></section>}
<script>
import {site} from '../../data/site';
const search=document.querySelector<HTMLInputElement>('#search');
const category=document.querySelector<HTMLSelectElement>('#category');
function filter(){let visible=0;document.querySelectorAll<HTMLElement>('[data-product]').forEach(card=>{const matches=(card.dataset.search??'').includes(search?.value.toLowerCase().trim()??'')&&(!category||category.value==='all'||card.dataset.category===category.value);card.hidden=!matches;if(matches)visible++;});const count=document.querySelector<HTMLElement>('#result-count');if(count)count.textContent=`${visible} ${document.documentElement.lang==='en'?count.dataset.en:count.dataset.id}`;const empty=document.querySelector<HTMLElement>('#empty-results');if(empty)empty.hidden=visible>0;}
search?.addEventListener('input',filter);category?.addEventListener('change',filter);
const product=document.querySelector<HTMLInputElement>('#enquiry-product');if(product)product.value=(new URLSearchParams(location.search).get('product')??'').slice(0,150);
document.querySelector<HTMLFormElement>('#enquiry-form')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);const en=document.documentElement.lang==='en';const text=`${en?'Hello MGA':'Halo MGA'},\n${en?'Name':'Nama'}: ${data.get('name')}\n${en?'Product / service':'Produk / layanan'}: ${data.get('product')||'-'}\n${en?'Requirements':'Kebutuhan'}: ${data.get('message')}`;location.href=`https://wa.me/${site.office.wa}?text=${encodeURIComponent(text)}`;});
</script>
</Layout>
