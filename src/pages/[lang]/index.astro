---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import ProductCard from '../../components/ProductCard.astro';
import {locales,pick,products,type Locale} from '../../data/site';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
const t=(en:string,id:string)=>pick(lang,en,id);
---
<Layout lang={lang} title={t('Laboratory glassware & custom solutions','Glassware laboratorium & solusi custom')}>
<section class="container hero"><div class="hero-copy"><span class="eyebrow"><i></i> {t('LABORATORY GLASSWARE · BANDUNG, INDONESIA','GLASSWARE LABORATORIUM · BANDUNG, INDONESIA')}</span><h1>{t('Precision in glass.','Presisi pada kaca.')}<br/><em>{t('Possibilities in science.','Peluang bagi sains.')}</em></h1><p class="lead">{t('Laboratory glassware and custom glass solutions for your research, education and industrial applications.','Glassware laboratorium dan solusi kaca custom untuk kebutuhan riset, pendidikan dan aplikasi industri Anda.')}</p><div class="actions"><a class="button" href={`/${lang}/products/`}>{t('Explore our products','Jelajahi produk')} <span>↗</span></a><a class="text-link" href={`/${lang}/about/`}>{t('Meet MGA','Kenali MGA')} →</a></div><div class="hero-note"><span></span>{t('From an initial idea to a glassware requirement.','Dari ide awal menjadi kebutuhan glassware.')}<br/>{t('Let’s find the right configuration together.','Temukan konfigurasi yang sesuai bersama kami.')}</div></div><a class="hero-visual" href={`/${lang}/products/rotary-evaporator/`} aria-label={t('Explore rotary evaporator','Lihat rotary evaporator')}><span class="figure-top">MGA / {t('PRODUCT SPOTLIGHT','PRODUK PILIHAN')}</span><div class="orbit"></div><img src="/images/rotary-evaporator.png" alt="Rotary evaporator" width="600" height="650" fetchpriority="high"/><div class="figure-bottom"><div><span class="eyebrow">{t('LABORATORY EQUIPMENT','PERALATAN LABORATORIUM')}</span><h2>Rotary Evaporator</h2></div><span class="round-arrow">↗</span></div></a></section>
<div class="strip"><div class="container strip-grid">{[[t('Laboratory glassware','Glassware laboratorium'),t('Explore equipment for your application.','Jelajahi alat untuk aplikasi Anda.')],[t('Custom requirements','Kebutuhan custom'),t('Start with your dimensions and drawing.','Mulai dari dimensi dan gambar Anda.')],[t('A direct conversation','Percakapan langsung'),t('Reach our office or workshop team.','Hubungi tim office atau workshop.')]].map((item,i)=><div><span>0{i+1}</span><div><h2>{item[0]}</h2><p>{item[1]}</p></div></div>)}</div></div>
<section class="container section about-grid"><div><span class="eyebrow">{t('THE COMPANY BEHIND THE GLASS','PERUSAHAAN DI BALIK KACA')}</span><h2>{t('Built around your laboratory needs.','Berangkat dari kebutuhan laboratorium Anda.')}</h2><p>{t('Based in Bandung, PT Mekanikal Glass Analitik brings laboratory glassware and custom requirements into one conversation. Explore our company, product range and the work described in our source materials.','Berbasis di Bandung, PT Mekanikal Glass Analitik menghadirkan glassware laboratorium dan kebutuhan custom dalam satu percakapan. Kenali perusahaan, pilihan produk dan pekerjaan yang tercatat dalam materi sumber kami.')}</p><a class="text-link" href={`/${lang}/about/`}>{t('Our story','Cerita kami')} →</a></div><div class="story-panel"><span class="eyebrow">{t('OUR ROOTS','AWAL PERJALANAN')}</span><strong>2006</strong><p>{t('The beginning of CV Karya Mekanikal Scientific, as recorded in the company materials.','Awal perjalanan CV Karya Mekanikal Scientific, sebagaimana tercatat pada materi perusahaan.')}</p><small>{t('Historical source; not the incorporation date of the PT.','Sumber riwayat; bukan tanggal pendirian PT.')}</small></div></section>
<section class="craft"><div class="container craft-grid"><div class="craft-photo"><img src="/images/production-source.jpeg" alt={t('Glassworking photograph from company materials','Foto pengerjaan kaca dari materi perusahaan')} loading="lazy" width="800" height="900"/></div><div><span class="eyebrow">{t('CUSTOM GLASSWARE','GLASSWARE CUSTOM')}</span><h2>{t('An idea. A drawing. A conversation.','Sebuah ide. Sebuah gambar. Sebuah percakapan.')}</h2><p>{t('Every application has its own requirements. Share the intended use, dimensions and connection details so our team can review your request.','Setiap aplikasi memiliki kebutuhan tersendiri. Sampaikan penggunaan, dimensi dan detail sambungan agar tim kami dapat meninjau permintaan Anda.')}</p><div class="steps">{[t('Share your application','Sampaikan aplikasi Anda'),t('Discuss the configuration','Diskusikan konfigurasi'),t('Request a quotation','Minta penawaran')].map((step,i)=><div><span>0{i+1}</span>{step}</div>)}</div><a class="text-link" href={`/${lang}/services/`}>{t('Explore custom services','Jelajahi layanan custom')} →</a></div></div></section>
<section class="section products-section"><div class="container"><div class="section-head"><div><span class="eyebrow">{t('EXPLORE THE RANGE','JELAJAHI PILIHAN')}</span><h2>{t('Glassware for your next step.','Glassware untuk langkah berikutnya.')}</h2></div><a class="text-link" href={`/${lang}/products/`}>{t('View catalogue','Lihat katalog')} →</a></div><div class="product-grid">{products.map(product=><ProductCard product={product} lang={lang}/>)}</div></div></section>
<section class="container section"><div class="section-head"><div><span class="eyebrow">{t('APPLICATIONS & EXPERIENCE','APLIKASI & PENGALAMAN')}</span><h2>{t('See the work in context.','Lihat pekerjaan dalam konteksnya.')}</h2></div><a class="text-link" href={`/${lang}/projects/`}>{t('Explore projects','Jelajahi proyek')} →</a></div><p class="section-intro">{t('Source case previews are available for discussion. Project details and publication permissions are awaiting confirmation.','Preview kasus dari sumber tersedia untuk diskusi. Detail proyek dan izin publikasi menunggu konfirmasi.')}</p></section>
<CTA lang={lang}/></Layout>
